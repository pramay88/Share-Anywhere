rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Shares collection (legacy)
    match /shares/{shareCode} {
      // Anyone can read shares (needed for receive flow)
      allow read: if true;
      
      // Anyone can create shares (anonymous or logged-in)
      allow create: if true;
      
      // Only owner can update their own shares
      // Or allow updates if no owner (anonymous shares)
      allow update: if resource.data.ownerId == null 
                    || isOwner(resource.data.ownerId);
      
      // Only owner can delete their shares
      // Or allow deletion if no owner (anonymous shares)
      allow delete: if resource.data.ownerId == null 
                    || isOwner(resource.data.ownerId);
    }
    
    // Transfers collection (main collection for file sharing)
    match /transfers/{transferId} {
      // Anyone can read transfers (needed for receive flow)
      allow read: if true;
      
      // Anyone can create transfers (anonymous or logged-in)
      allow create: if true;
      
      // Only owner can update their own transfers
      // Or allow updates if no owner (anonymous transfers)
      allow update: if resource.data.owner_id == null 
                    || isOwner(resource.data.owner_id);
      
      // Only owner can delete their transfers
      // Or allow deletion if no owner (anonymous transfers)
      allow delete: if resource.data.owner_id == null 
                    || isOwner(resource.data.owner_id);
      
      // Files subcollection within transfers
      match /files/{fileId} {
        allow read: if true;
        allow create: if true;
        allow update: if true;
        allow delete: if true;
      }
    }
    
    // Download logs collection
    match /download_logs/{logId} {
      allow read: if true;
      allow create: if true;
      allow update: if false;
      allow delete: if false;
    }
    
    // User stats collection
    match /userStats/{userId} {
      // Users can only read their own stats
      allow read: if isOwner(userId);
      
      // Users can create their own stats
      allow create: if isOwner(userId);
      
      // Users can update their own stats
      allow update: if isOwner(userId);
      
      // Users cannot delete stats (optional - remove if you want deletion)
      allow delete: if false;
    }
    
    // P2P sessions collection (for WebRTC signaling)
    match /p2p_sessions/{sessionId} {
      allow read: if true;  // Anyone can read to join sessions
      allow create: if true; // Anyone can create sessions
      allow update: if true; // Anyone can update for signaling
      allow delete: if true; // Allow cleanup
    }
    
    // Analytics collections (server writes only, but readable)
    match /analytics/{docId} {
      allow read: if true;  // Global stats are public
      allow write: if false; // Only server can write
    }
    
    match /analytics_users/{userId} {
      allow read: if isOwner(userId); // Users can read their own analytics
      allow write: if false; // Only server can write
    }
    
    match /active_shares/{shareId} {
      allow read: if true;  // Anyone can read active shares
      allow write: if false; // Only server can write
    }
    
    match /history/{historyId} {
      allow read: if true;  // Users can read history (filtered by API)
      allow write: if false; // Only server can write
    }
  }
}
