rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Shares collection
    match /shares/{shareCode} {
      // Anyone can read shares (needed for receive flow)
      allow read: if true;
      
      // Anyone can create shares (anonymous or logged-in)
      allow create: if true;
      
      // Only owner can update their own shares
      // Or allow updates if no owner (anonymous shares)
      allow update: if resource.data.ownerId == null 
                    || isOwner(resource.data.ownerId);
      
      // Only owner can delete their shares
      // Or allow deletion if no owner (anonymous shares)
      allow delete: if resource.data.ownerId == null 
                    || isOwner(resource.data.ownerId);
    }
    
    // User stats collection
    match /userStats/{userId} {
      // Users can only read their own stats
      allow read: if isOwner(userId);
      
      // Users can create their own stats
      allow create: if isOwner(userId);
      
      // Users can update their own stats
      allow update: if isOwner(userId);
      
      // Users cannot delete stats (optional - remove if you want deletion)
      allow delete: if false;
    }
    
    // Deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
