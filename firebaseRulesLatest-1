rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Transfers collection
    match /transfers/{transferId} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if request.auth != null && 
                              (resource.data.owner_id == null || 
                               request.auth.uid == resource.data.owner_id);
      
      match /files/{fileId} {
        allow read: if true;
        allow create: if true;
        allow delete: if request.auth != null;
      }
    }
    
    // Download logs collection
    match /download_logs/{logId} {
      allow create: if true;
      allow read: if request.auth != null && 
                     (resource.data.downloaded_by == null || 
                      request.auth.uid == resource.data.downloaded_by);
    }
    
    // Offline Share - Device presence
    match /offline_share_devices/{deviceId} {
      allow read, write: if true;
    }
    
    // Offline Share - WebRTC signaling
    match /webrtc_signals/{signalId} {
      allow read, write: if true;
    }
  }
}
